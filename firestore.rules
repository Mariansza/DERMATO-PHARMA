rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pharmacists collection - authenticated users can read/write
    match /pharmacists/{docId} {
      allow read, write: if request.auth != null;
    }

    // Cases collection - authenticated users can read/write
    match /cases/{docId} {
      allow read, write: if request.auth != null;
    }

    // Photos collection - authenticated users can read/write
    match /photos/{docId} {
      allow read, write: if request.auth != null;
    }

    // Medical opinions - authenticated users can read/write
    match /medicalOpinions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Audit logs - authenticated users can read/write
    match /auditLogs/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
