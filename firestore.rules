rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pharmacists collection - anyone can create, authenticated can read/update
    match /pharmacists/{docId} {
      allow create: if true;  // Pharmaciens peuvent s'enregistrer
      allow read, update, delete: if request.auth != null;
    }

    // Cases collection - anyone can create, authenticated can read/update
    match /cases/{docId} {
      allow create: if true;  // Soumission publique de dossiers
      allow read, update, delete: if request.auth != null;
    }

    // Photos collection - anyone can create, authenticated can read/update
    match /photos/{docId} {
      allow create: if true;  // Upload de photos avec le dossier
      allow read, update, delete: if request.auth != null;
    }

    // Medical opinions - authenticated users only
    match /medicalOpinions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Audit logs - anyone can create, authenticated can read/update
    match /auditLogs/{docId} {
      allow create: if true;  // Création de logs lors de soumission
      allow read, update, delete: if request.auth != null;
    }

    // Users collection - users can read their own data, super_users can read all
    match /users/{userId} {
      // Lecture : soi-même OU super_user peut lire tous les utilisateurs
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_user'
      );
      // Écriture : soi-même uniquement
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Questionnaire responses collection - patient triage B2C
    match /questionnaire_responses/{document} {
      allow create: if true;           // Soumissions anonymes patients
      allow read: if request.auth != null;  // Lecture authentifiée (médecins)
      allow update, delete: if false;  // Immutable
    }
  }
}
