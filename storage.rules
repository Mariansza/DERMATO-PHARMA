rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos folder - anyone can upload, only authenticated can read
    match /photos/{allPaths=**} {
      allow write: if true;  // Upload public pour soumission
      allow read: if request.auth != null;  // Lecture restreinte aux médecins
    }

    // Prescriptions folder - authenticated users only
    match /prescriptions/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Reports folder - authenticated users only
    match /reports/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
