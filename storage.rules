rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos folder - authenticated users can read/write
    match /photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Prescriptions folder - authenticated users can read/write
    match /prescriptions/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Reports folder - authenticated users can read/write
    match /reports/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Documents folder - authenticated users can read/write
    match /documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
